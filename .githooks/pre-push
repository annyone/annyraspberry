#!/bin/sh
# Проверки перед отправкой в GitHub.
#
# Пуш в main запускает деплой на reg.ru, поэтому поломку дешевле найти здесь.
# Сборка в хук не включена намеренно: она добавляет около минуты к каждому
# git push, а формат и тесты укладываются в секунды. Полную проверку вместе
# со сборкой запускают вручную: npm run check
#
# Хук включается один раз на машине:  git config core.hooksPath .githooks
# Обойти при необходимости:           git push --no-verify
set -e
cd "$(dirname "$0")/../portfolio"
npm run format:check
npm run test:once
