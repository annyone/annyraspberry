# Единые настройки редактора для всех, кто открывает репозиторий.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# В Markdown два пробела в конце строки — это перенос строки, их нельзя срезать.
trim_trailing_whitespace = false
